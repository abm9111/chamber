{
  "name": "@bu7umaid/chamber",
  "version": "0.1.3",
  "type": "module",
  "description": "Ask questions about your own notes and get answers that cite their sources — then get told when a source changed underneath a conclusion. Local-first CLI + MCP server, zero runtime dependencies.",
  "license": "MIT",
  "mcpName": "io.github.abm9111/chamber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abm9111/chamber.git"
  },
  "homepage": "https://github.com/abm9111/chamber#readme",
  "bugs": {
    "url": "https://github.com/abm9111/chamber/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "notes",
    "obsidian",
    "citations",
    "provenance",
    "local-first",
    "rag",
    "sqlite",
    "knowledge-management",
    "drift-detection"
  ],
  "bin": {
    "chamber": "bin/chamber.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "sql/",
    "scripts/",
    "deploy/",
    "docs/KNOWN_LIMITATIONS.md",
    "fixtures/demo/"
  ],
  "scripts": {
    "test": "node --experimental-strip-types tests/harness.ts",
    "typecheck": "tsc --noEmit",
    "test:gates": "node --experimental-strip-types tests/harness.ts --suite=gates",
    "test:spend": "node --experimental-strip-types tests/harness.ts --suite=spend",
    "test:approvals": "node --experimental-strip-types tests/harness.ts --suite=approvals",
    "test:audit": "node --experimental-strip-types tests/harness.ts --suite=audit",
    "demos": "rc=0; for f in demos/*.ts; do node --experimental-strip-types \"$f\" || rc=1; done; exit $rc",
    "probes": "rc=0; node --experimental-strip-types probes/gate_audit.ts || rc=1; node --experimental-strip-types probes/pin_bypass.ts || rc=1; node --experimental-strip-types probes/verify_partial_drift.ts || rc=1; node --experimental-strip-types probes/debt_paraphrase.ts || rc=1; node --experimental-strip-types probes/harness_declaration_guards.ts || rc=1; CHAMBER_SANDBOX_REQUIRED=1 node --experimental-strip-types probes/sandbox_escape.ts || rc=1; exit $rc",
    "cli": "node --experimental-strip-types src/cli.ts",
    "turn": "node --experimental-strip-types src/cli.ts turn",
    "status": "node --experimental-strip-types src/cli.ts status",
    "server": "node --experimental-strip-types src/server.ts",
    "mcp": "node --experimental-strip-types src/mcp_server.ts",
    "gateway": "node --experimental-strip-types src/gateway_runner.ts",
    "cron-run": "node --experimental-strip-types src/cli.ts cron run",
    "launch": "node --experimental-strip-types src/cli.ts status",
    "gateway:telegram": "node --experimental-strip-types src/gateway_runner.ts telegram",
    "serve": "node --experimental-strip-types src/server.ts",
    "gateway:slack": "node --experimental-strip-types src/slack_runner.ts",
    "gateway:discord": "node --experimental-strip-types src/discord_runner.ts",
    "lint": "eslint src tests probes demos scripts",
    "probes:isolation": "CHAMBER_SANDBOX_REQUIRED=1 node --experimental-strip-types probes/sandbox_confines.ts",
    "calibrate:paraphrase": "node --experimental-strip-types scripts/calibrate_paraphrase_threshold.ts",
    "eval:retrieval": "node --experimental-strip-types scripts/eval_retrieval.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@slack/bolt": "^5.0.0",
    "@types/node": "^24.13.3",
    "discord.js": "^14.27.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
