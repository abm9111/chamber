{
  "name": "chamber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chamber week-1 kernel — governable cognition gates",
  "bin": {
    "chamber": "src/cli.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/harness.ts",
    "typecheck": "tsc --noEmit",
    "test:gates": "node --experimental-strip-types tests/harness.ts --suite=gates",
    "test:spend": "node --experimental-strip-types tests/harness.ts --suite=spend",
    "test:approvals": "node --experimental-strip-types tests/harness.ts --suite=approvals",
    "test:audit": "node --experimental-strip-types tests/harness.ts --suite=audit",
    "probes": "rc=0; node --experimental-strip-types probes/gate_audit.ts || rc=1; node --experimental-strip-types probes/pin_bypass.ts || rc=1; CHAMBER_SANDBOX_REQUIRED=1 node --experimental-strip-types probes/sandbox_escape.ts || rc=1; exit $rc",
    "cli": "node --experimental-strip-types src/cli.ts",
    "turn": "node --experimental-strip-types src/cli.ts turn",
    "status": "node --experimental-strip-types src/cli.ts status",
    "server": "node --experimental-strip-types src/server.ts",
    "gateway": "node --experimental-strip-types src/gateway_runner.ts",
    "cron-run": "node --experimental-strip-types src/cli.ts cron run",
    "launch": "node --experimental-strip-types src/cli.ts status",
    "gateway:telegram": "node --experimental-strip-types src/gateway_runner.ts telegram",
    "serve": "node --experimental-strip-types src/server.ts",
    "gateway:slack": "node --experimental-strip-types src/slack_runner.ts",
    "gateway:discord": "node --experimental-strip-types src/discord_runner.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
